@model EscolaSimples.Models.Aluno

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="text-center mb-4">Cadastrar Novo Aluno</h2>

                    <form asp-action="Criar" method="post">

                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label">Nome</label>
                            <input asp-for="Nome" class="form-control" placeholder="Digite o nome do aluno" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Matricula" class="form-label">Matrícula</label>
                            <input asp-for="Matricula" class="form-control" placeholder="Digite a matrícula" />
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary">
                                Cadastrar Aluno
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>